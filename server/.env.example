# Copy to server/.env and fill in. Never commit .env.
# Leave JIRA_* empty to run on built-in sample data.
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
# Optional: skip auto-discovery of the "Start date" field (team-managed projects are often customfield_10015)
JIRA_START_DATE_FIELD=
PORT=3001
