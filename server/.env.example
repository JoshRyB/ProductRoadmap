# Copy to server/.env and fill in. Never commit .env.
# ---------- Putting it online (see docs/DEPLOY.md) ----------
# On your own computer none of this is needed. Online, the server refuses to start without a password.
# ACCESS_PASSWORD=          # at least 12 characters
# SESSION_SECRET=           # at least 32 random characters, e.g. from: openssl rand -hex 32
# TRUST_PROXY=1             # when a host's HTTPS front door sits in front of the app
# ALLOWED_HOSTS=roadmap.example.com
# SESSION_HOURS=12

# Fill in the Jira block OR the Azure DevOps block. Leave both empty to run on built-in sample data.
# If both are filled in, Jira is used unless you set PROVIDER=ado.
# PROVIDER=jira

PORT=3001

# ---------- Jira ----------
JIRA_BASE_URL=https://your-site.atlassian.net
JIRA_EMAIL=you@example.com
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
# Optional: skip auto-discovery of the "Start date" field (team-managed projects are often customfield_10015)
JIRA_START_DATE_FIELD=

# ---------- Azure DevOps ----------
# Create a personal access token (User settings > Personal access tokens) with read-only scopes:
# "Work Items: Read" and "Project and Team: Read".
ADO_ORG_URL=https://dev.azure.com/your-organisation
ADO_PROJECT=
ADO_PAT=
# Optional. Team whose sprints (iterations) to show. Defaults to the project's default team.
ADO_TEAM=
# Optional. Work item types to show as Epics and as Features (comma separated).
# Agile, Scrum and CMMI processes use Epic and Feature. On the Basic process use ADO_FEATURE_TYPES=Issue.
ADO_EPIC_TYPES=Epic
ADO_FEATURE_TYPES=Feature
# Optional. "iterations" shows a folder of sprints (for example Release 1 containing Sprint 1 to 4) as a release.
# "none" shows no releases.
ADO_RELEASES=iterations
